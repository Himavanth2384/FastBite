@model FastBite.Models.Viewmodels.MenuItemViewModel
@using FastBite.Extensions
@{
    ViewData["Title"] = "Delete";
     Layout = "~/Views/Shared/_Layout.cshtml";
}
<br/>
<h2 class="text-info">Delete MenuItem</h2>
<br/>
<form asp-action="Delete" asp-route-id="@Model.MenuItem.Id">
    <div class="border backgroundwhite">
        <div class="form-group row">
            <div class="col-2">
                <label>Name</label>
            </div>
            <div class="col-5">
                <input value="@Model.MenuItem.Name" id="Name" class="form-control" readonly="readonly" />
            </div>
        </div>
        <div class="form-group row">
            <div class="col-2">
                <label>price</label>
            </div>
            <div class="col-5">
                <input value="@Model.MenuItem.price" class="form-control" readonly="readonly" />
            </div>
        </div>
        <partial name="_deleteAndBackPartialView" model="Model.MenuItem.Id" />
    </div>
</form>
