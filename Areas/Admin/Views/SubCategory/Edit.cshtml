@model FastBite.Models.Viewmodels.CategoryAndSubCategoryModel
@using FastBite.Extensions


@{
    ViewData["Title"] = "Edit";
     Layout = "~/Views/Shared/_Layout.cshtml";
}
<br/>
<h2 class="text-info">Edit SubCategory</h2>
<br/>
<div class="row">
    <div class="col-8">
        <form asp-action="Edit" asp-route-id="@Model.subCategory.Id">
            <div class="border backgroundwhite">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group row">
                    <div class="col-3">
                        <label asp-for="subCategory.CategoryId" class="col-form-label">CategoryId</label>
                    </div>
                    <div class="col-6">
                        <select asp-for="subCategory.CategoryId" asp-items="Model.categoryList.ToSelectListItem(Model.subCategory.CategoryId)" id="ddCategoryList" class="form-control"></select>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-3">
                        <label asp-for="subCategory.Name" class="col-form-label">SubCategoryName</label>
                    </div>
                    <div class="col-6">
                        <input asp-for="subCategory.Name" id="subCategory_Name" class="form-control" />
                    </div>
                    <span asp-validation-for="subCategory.Name" class="text-danger"></span>
                </div>
                <partial name="_EditAndBackPartialView" model="Model.subCategory.Id" />
            </div>
        </form>
    </div>
    <div class="col-4">
        <h5>Existingsub</h5>
        <div class="list-group">
            @foreach (var s in Model.subCategoryList)
            {
                <div class="list-group-item">@s</div>
            }
        </div>
    </div>
</div>
