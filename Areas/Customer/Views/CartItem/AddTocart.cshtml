
@model CartItem
@using FastBite.Extensions
@{
    ViewData["Title"] = "AddToCart";
     Layout = "~/Views/Shared/_Layout.cshtml";
}
<br/>
<h2 class="text-info">Add to cart</h2>
<br/>
<form asp-action="AddTocart" asp-route-id="@Model.MenuItemId" method="post">
    <div class="row">
        <div class="col-8 border backgroundwhite">
            <div class="form-group row">
                <div class="col-3">
                    <label class="col-form-label">Name</label>
                </div>
                <div class="col-6">
                    <input value="@Model.MenuItem.Name" id="MenuItem_Name" class="form-control" readonly="readonly" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3">
                    <label class="col-form-label">description</label>
                </div>
                <div class="col-6">
                    <input value="@Model.MenuItem.description" id="MenuItem_description" class="form-control" readonly="readonly" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3">
                    <label class="col-form-label">price</label>
                </div>
                <div class="col-6">
                    <input value="@Model.MenuItem.price" id="MenuItem_price" class="form-control" readonly="readonly" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3">
                    <label class="col-form-label">Count</label>
                </div>
                <div class="col-6">
                    <input type="number" id="Count" name="Count" value="@Model.Count" min="1" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <button type="submit" class="btn btn-info form-control">AddToCart</button>
                </div>
                <div class="col-6">
                    <a asp-controller="Home" asp-action="MenuItems" asp-route-id="@Model.MenuItem.RestaurantId" class="btn btn-success form-control">Back To List</a>
                </div>
            </div>
        </div>
        <div class="col-4">
            <img src="@Model.MenuItem.imageUrl" style="max-width:150px" />
        </div>
    </div>
</form>
